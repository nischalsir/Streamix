<?xml version="1.0" encoding="utf-8"?>
<!-- Focus on a settings row without a tick box: a soft violet highlight with a bright edge, no hard outline -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#3D7C5CFF" />
                </shape>
            </item>
            <item
                android:width="3dp"
                android:gravity="start">
                <shape android:shape="rectangle">
                    <corners
                        android:bottomLeftRadius="12dp"
                        android:topLeftRadius="12dp" />
                    <solid android:color="@color/streamix_accent_light" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
