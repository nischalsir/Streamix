<?xml version="1.0" encoding="utf-8"?>
<!-- TV player: a soft shade at the top (logo, time) and a deeper one at the bottom (what's playing and the
     controls), so the picture stays clear in the middle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="150dp"
        android:gravity="top">
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="#8C000000" />
        </shape>
    </item>
    <item
        android:height="330dp"
        android:gravity="bottom">
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#5C000000"
                android:endColor="#00000000"
                android:startColor="#D9000000" />
        </shape>
    </item>
</layer-list>
