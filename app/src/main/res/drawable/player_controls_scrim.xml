<?xml version="1.0" encoding="utf-8"?>
<!-- Behind the player controls: an indigo-black shade only at the top (title) and bottom (time bar,
     buttons), so the picture stays clear in the middle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="180dp"
        android:gravity="top">
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#000E0C19"
                android:startColor="#B30E0C19" />
        </shape>
    </item>
    <item
        android:height="300dp"
        android:gravity="bottom">
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#8C0E0C19"
                android:endColor="#000E0C19"
                android:startColor="#E60E0C19" />
        </shape>
    </item>
</layer-list>
